<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/navbar") %>

<main class="home">
<img
    class="home-logo"
    src="/logo/Clientflow.png"
    alt="ClientFlow Logo"
>
<h1>ClientFlow</h1>

<% if (user) { %>

<h2>Welcome, <%= user.username %></h2>

<p>Manage your clients and projects in one place.</p>

<div class="home-links">

<a href="/clients">My Clients</a>

<a href="/projects">My Projects</a>

<a href="/clients/new">Add Client</a>

<a href="/projects/new">Create Project</a>

</div>

<% } else { %>

<p>Manage your clients and projects in one place.</p>

<div class="home-links">

<a href="/auth/sign-in">Sign In</a>

<a href="/auth/sign-up">Create Account</a>

</div>

<% } %>

</main>

</body>
</html>
