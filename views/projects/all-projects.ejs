<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects</title>
</head>
<body>
    <h1>My Projects</h1>
  

    <a href="/projects/new">Add Projects</a>

    <h2>view your projects :</h2>
    <div class="projects-container">

    <% for(let project of projects){ %>

    <div class="project-card">

    <h2>
    <a href="/projects/<%= project._id %>" title="Click to see details">
    <%= project.title %>
    </a>
    </h2>

    <p>Description: <%= project.description %></p>

    <p>Price: <%= project.price %></p>

    <p>Status: <%= project.status %></p>

<p>
    Deadline:
    <%= new Date(project.deadline).getDate() %>/
    <%= new Date(project.deadline).getMonth() + 1 %>/
    <%= new Date(project.deadline).getFullYear() %>
</p>

    </div>

 <% } %>

    </div>


    

</body>
</html>