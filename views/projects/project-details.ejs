<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Details | ClientFlow</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("../partials/navbar.ejs") %>

<main class="project-details-page">

<div class="pdf-header">
<img src="/logo/Clientflow.png" alt="ClientFlow Logo">
</div>

<a class="back-link" href="/projects">← Back to Projects</a>

<div class="details-card">

<div class="details-header">

<div>
<p class="details-label">PROJECT DETAILS</p>
<h1><%= project.title %></h1>
</div>

<span class="details-status"><%= project.status %></span>

</div>

<div class="details-section">

<h3>Description</h3>
<p><%= project.description %></p>

</div>

<div class="details-info">

<div>
<span>Client</span>
<strong><%= project.client.name %></strong>
</div>

<div>
<span>Price</span>
<strong><%= project.price %> BHD</strong>
</div>

<div>
<span>Deadline</span>
<strong>
<%= new Date(project.deadline).getDate() %>/
<%= new Date(project.deadline).getMonth() + 1 %>/
<%= new Date(project.deadline).getFullYear() %>
</strong>
</div>

</div>

<div class="details-actions">

<a class="edit-button" href="/projects/<%= project._id %>/edit">Edit Project</a>

<button class="pdf-button" type="button" onclick="window.print()">Export PDF</button>

<form action="/projects/<%= project._id %>?_method=DELETE" method="POST">
<button class="delete-button" type="submit">Delete Project</button>
</form>

</div>

</div>

</main>

</body>
</html>